ARG BASE_IMAGE=python@sha256:78387bc3881b8273120a12ebe6c1ab22b018ccc2c9adf565ae1ac9b536e184ea
FROM ${BASE_IMAGE}
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
COPY requirements.lock.txt /app/requirements.lock.txt
COPY requirements.main-image-api.txt /app/requirements.txt
ARG PIP_OFFLINE=0
RUN PIP_NO_INDEX=$PIP_OFFLINE PIP_DISABLE_PIP_VERSION_CHECK=1 \
    pip install --no-cache-dir -r /app/requirements.txt
RUN mkdir -p /app/app
COPY app/__init__.py app/brands.py app/service_auth.py app/shop_directory.py /app/app/
COPY dev/main-image-service/*.py /app/main-image-service/
COPY dev/main-image-service/tool /app/main-image-service/tool
RUN python -c "import sys; sys.path.insert(0, '/app/main-image-service'); import server"
CMD ["uvicorn", "server:app", "--app-dir", "/app/main-image-service", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
