ARG BASE_IMAGE=python@sha256:78387bc3881b8273120a12ebe6c1ab22b018ccc2c9adf565ae1ac9b536e184ea
FROM ${BASE_IMAGE}
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
COPY requirements.lock.txt /app/requirements.lock.txt
COPY requirements.governance-api.txt /app/requirements.txt
ARG PIP_OFFLINE=0
RUN PIP_NO_INDEX=$PIP_OFFLINE PIP_DISABLE_PIP_VERSION_CHECK=1 pip install --no-cache-dir -r /app/requirements.txt
RUN mkdir -p /app/app/static
COPY app/__init__.py app/assets_api.py app/categories.py app/coverage_engine.py app/coverage_monitor.py app/business_review.py app/pool_management.py app/service_auth.py app/governance_service.py /app/app/
COPY app/static/model_params.json /app/app/static/model_params.json
RUN python -c "import app.governance_service"
CMD ["uvicorn", "app.governance_service:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
