ARG BASE_IMAGE=python@sha256:78387bc3881b8273120a12ebe6c1ab22b018ccc2c9adf565ae1ac9b536e184ea
FROM ${BASE_IMAGE}
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
COPY requirements.lock.txt /app/requirements.lock.txt
COPY requirements.white-api.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt
RUN mkdir -p /app/app/static
COPY app/__init__.py app/assets_api.py app/categories.py app/service_auth.py app/white_gallery_service.py /app/app/
COPY app/static/model_params.json /app/app/static/model_params.json
CMD ["uvicorn", "app.white_gallery_service:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
